{
  "name": "fushi-tabletop",
  "private": true,
  "version": "0.1.0-alpha.91",
  "description": "Mesa virtual desktop do RPG FUSHI com campanha e multiplayer.",
  "author": {
    "name": "Projeto RPG FUSHI"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "base:diagnose": "node scripts/validate-base-upgrades.cjs",
    "asset:audit": "node scripts/audit-assets.cjs",
    "asset:maps:optimize": "node scripts/optimize-assets.cjs --write --force --max-dimension=2048 --quality=88 --limit=999",
    "bundle:audit": "node scripts/audit-build-bundles.cjs",
    "audio:audit": "node scripts/audit-audio-library.cjs",
    "audio:audit:deep": "node scripts/audit-audio-library.cjs --deep",
    "books:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/audit-rulebooks.ps1",
    "books:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-rulebooks.ps1",
    "books:combat-v2": "node scripts/update-rulebooks-combat-v2.mjs",
    "books:inventory": "node scripts/update-rulebooks-inventory.mjs",
    "books:statuses": "node scripts/update-rulebooks-statuses.mjs",
    "asset:optimize": "node scripts/optimize-assets.cjs",
    "campaign-pack:build": "node scripts/build-campaign-pack.cjs",
    "content:audit": "node scripts/audit-content-readiness.cjs",
    "content:install-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-content-library.ps1",
    "lore:npc:apply": "node scripts/apply-lore-npcs.cjs --write",
    "lore:npc:audit": "node scripts/audit-lore-npcs.cjs",
    "lore:npc:plan": "node scripts/apply-lore-npcs.cjs",
    "combat:v2:plan": "node scripts/migrate-combat-v2.cjs",
    "combat:v2:apply": "node scripts/migrate-combat-v2.cjs --write",
    "combat:v2:defenses": "node scripts/migrate-combat-v2.cjs --write --defenses-only",
    "combat:simulate": "node scripts/simulate-combat-v2.cjs",
    "combat:builds:plan": "node scripts/plan-combat-builds-v1.cjs",
    "combat:builds:balance": "node scripts/balance-npc-builds.cjs",
    "combat:builds:apply": "node scripts/balance-npc-builds.cjs --write",
    "combat:builds:simulate": "node scripts/simulate-build-loadouts.cjs --iterations=1000",
    "combat:audit": "node scripts/audit-combat-actions.cjs",
    "status:audit": "node scripts/audit-character-status-effects.cjs",
    "smoke:combat-v2": "node scripts/smoke-combat-v2.cjs",
    "smoke:combat-runtime": "node scripts/smoke-combat-runtime.mjs",
    "smoke:combat-flow:ui": "node scripts/smoke-combat-flow-playwright.cjs",
    "smoke:statuses": "node scripts/smoke-status-effects.mjs",
    "smoke:statuses:ui": "node scripts/smoke-combat-flow-playwright.cjs --status-visual-only",
    "smoke:inventory": "node scripts/smoke-inventory.mjs",
    "smoke:builds": "node scripts/smoke-build-catalog.cjs && node scripts/smoke-npc-builds.cjs",
    "smoke:builds:live": "node scripts/smoke-build-catalog.cjs && node scripts/smoke-npc-builds.cjs --live",
    "smoke:training": "node scripts/smoke-training-arc.cjs",
    "smoke:training:ui": "node scripts/smoke-training-playwright.cjs",
    "smoke:events": "node scripts/smoke-events.cjs",
    "smoke:stages": "node scripts/smoke-character-stages.cjs",
    "math:npc:apply": "node scripts/balance-npc-math.cjs --write",
    "math:npc:plan": "node scripts/balance-npc-math.cjs",
    "mun:interludes:audit": "node scripts/audit-mun-interludes.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:close": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/close-packaged-app.ps1",
    "release:dir": "electron-builder --config electron-builder.json --win dir --x64",
    "release:distributables": "electron-builder --config electron-builder.json --prepackaged release/win-unpacked --win nsis-web nsis --x64",
    "release:stamp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stamp-packaged-app.ps1",
    "release:installer": "npm run release:close && npm run build && npm run release:dir && npm run release:stamp && npm run release:distributables",
    "release:assets": "node scripts/validate-release-assets.cjs",
    "perf:release": "node scripts/perf-release-tabletop.cjs",
    "smoke:multiplayer": "node scripts/smoke-multiplayer.cjs",
    "smoke:multiplayer:soak": "node scripts/smoke-multiplayer-soak.cjs",
    "smoke:rulebooks": "node scripts/smoke-rulebooks.cjs",
    "smoke:rulebooks:release": "node scripts/smoke-rulebooks-release.cjs",
    "smoke:interludes": "node scripts/smoke-release-deep.cjs --only=mun-interludes",
    "smoke:lighting": "node scripts/smoke-release-deep.cjs --only=day-night-lighting",
    "smoke:release": "node scripts/smoke-release-playwright.cjs",
    "smoke:release:deep": "node scripts/smoke-release-deep.cjs",
    "smoke:ui": "node scripts/smoke-playwright.cjs",
    "updates:serve-lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-free-update-server.ps1 -Mode lan",
    "updates:serve-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-free-update-server.ps1 -Mode local",
    "updates:serve-tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-free-update-server.ps1 -Mode tunnel",
    "electron:build": "npm run release:installer"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.27.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.18.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.16",
    "vite-plugin-glsl": "^1.6.0"
  }
}
